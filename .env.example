# ─────────────────────────────────────────────────────────────────────────────
#  Cocoya Coffee House — environment variables
#  Copy to `.env.local` for local development; set the same keys in your host
#  (e.g. Vercel → Project → Settings → Environment Variables) for production.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (used for SEO, sitemap, Open Graph and email links).
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# ── Supabase (feedback storage + admin login) ───────────────────────────────
# All three are SERVER-ONLY. Nothing here is exposed to the browser.
# Supabase Dashboard → Project Settings → API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable" key (sb_publishable_…) — or the legacy anon key via SUPABASE_ANON_KEY
SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (sb_secret_…) — or the legacy service_role key via SUPABASE_SERVICE_ROLE_KEY
# ⚠️ Bypasses Row Level Security. Never commit it, never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Random string used to hash visitor IPs for rate limiting (raw IPs are never stored).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FEEDBACK_IP_SALT=

# ── Owner email for every new feedback (guest name, mobile, rating, comment…) ─
# Email via Resend (https://resend.com, free tier is plenty). All three must be
# set, or no email is sent. Template: src/lib/email/feedback-email.ts
#  • RESEND_API_KEY: Resend → API Keys → Create.
#  • FEEDBACK_NOTIFY_EMAIL: where alerts go; comma-separate for several people.
#  • FEEDBACK_FROM_EMAIL: must use a domain verified in Resend → Domains.
#    No domain yet? Use "Cocoya Feedback <onboarding@resend.dev>"; Resend then
#    only delivers to the email address you signed up to Resend with.
RESEND_API_KEY=
FEEDBACK_NOTIFY_EMAIL=owner@your-domain.com
FEEDBACK_FROM_EMAIL="Cocoya Feedback <feedback@your-domain.com>"

# Any webhook that accepts JSON (Slack, Zapier, Make, n8n, Google Chat…).
FEEDBACK_WEBHOOK_URL=
